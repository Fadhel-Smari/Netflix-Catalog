<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="750.0" prefWidth="1150.0" stylesheets="@../style/theme.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.maisonneuve.netflix.controller.PrincipalController">
    <top>
        <VBox spacing="12.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="12.0" left="15.0" right="15.0" top="15.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Label styleClass="title-label" text="Catalog Netflix" />
                    </children>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <TextField fx:id="txtRecherche" promptText="🔍 Rechercher par titre, réalisateur ou description" HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnBenchmark" onAction="#ouvrirBenchmark" text="Benchmark des Tris" />
                        <Button fx:id="btnWatchlist" onAction="#toggleWatchlistVue" text="Ma Watchlist (0)" />
                    </children>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <ComboBox fx:id="comboType" promptText="Type" prefWidth="100.0" />
                        <ComboBox fx:id="comboGenre" promptText="Genre" prefWidth="130.0" />
                        <ComboBox fx:id="comboDecennie" promptText="Décennie" prefWidth="110.0" />
                        <Separator orientation="VERTICAL" />
                        <HBox alignment="CENTER_LEFT" spacing="6.0">
                            <children>
                                <Label text="Note min :" />
                                <Slider fx:id="sliderNoteMin" prefWidth="100.0" />
                                <Label fx:id="lblNoteMin" text="0.0" minWidth="25.0" style="-fx-font-weight: bold;" />
                            </children>
                        </HBox>
                        <Separator orientation="VERTICAL" />
                        <ComboBox fx:id="comboTri" promptText="Trier par..." prefWidth="150.0" />
                        <ComboBox fx:id="comboAlgo" promptText="Algorithme" prefWidth="120.0" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnReinitialiser" onAction="#reinitialiserFiltres" text="Réinitialiser" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </top>
    <center>
        <SplitPane dividerPositions="0.65" BorderPane.alignment="CENTER">
            <items>
                <VBox spacing="10.0">
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                    <children>
                        <TableView fx:id="tableMedias" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colTitre" prefWidth="220.0" text="Titre" />
                                <TableColumn fx:id="colType" prefWidth="80.0" text="Type" />
                                <TableColumn fx:id="colAnnee" prefWidth="70.0" text="Année" />
                                <TableColumn fx:id="colNote" prefWidth="60.0" text="Note" />
                                <TableColumn fx:id="colGenre" prefWidth="120.0" text="Genre" />
                                <TableColumn fx:id="colPays" prefWidth="130.0" text="Pays" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" />
                            </columnResizePolicy>
                        </TableView>
                        <HBox alignment="CENTER" spacing="15.0">
                            <children>
                                <Button fx:id="btnPagePrecedente" onAction="#pagePrecedente" text="&lt; Précédent" />
                                <Label fx:id="lblPage" text="Page 1 / 1" />
                                <Button fx:id="btnPageSuivante" onAction="#pageSuivante" text="Suivant &gt;" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
                <VBox spacing="15.0" styleClass="detail-panel">
                    <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                    </padding>
                    <children>
                        <Label styleClass="section-header" text="Détails du média" />
                        <VBox spacing="2.0">
                            <children>
                                <Label fx:id="lblTitreDetail" styleClass="detail-title" text="Sélectionnez un média" wrapText="true" />
                                <Label fx:id="lblTitreOriginal" styleClass="detail-subtitle" text="" wrapText="true" />
                            </children>
                        </VBox>
                        <Separator />
                        <GridPane hgap="10.0" vgap="8.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="NEVER" minWidth="100.0" />
                                <ColumnConstraints hgrow="ALWAYS" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints />
                                <RowConstraints />
                                <RowConstraints />
                                <RowConstraints />
                                <RowConstraints />
                                <RowConstraints />
                                <RowConstraints />
                                <RowConstraints />
                            </rowConstraints>
                            <children>
                                <Label text="Type :" />
                                <Label fx:id="lblTypeDetail" GridPane.columnIndex="1" />
                                <Label text="Année :" GridPane.rowIndex="1" />
                                <Label fx:id="lblAnneeDetail" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                <Label text="Genre :" GridPane.rowIndex="2" />
                                <Label fx:id="lblGenreDetail" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                <Label text="Réalisateur :" GridPane.rowIndex="3" />
                                <Label fx:id="lblRealisateurDetail" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                                <Label text="Pays :" GridPane.rowIndex="4" />
                                <Label fx:id="lblPaysDetail" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                                <Label text="Note :" GridPane.rowIndex="5" />
                                <Label fx:id="lblNoteDetail" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                                <Label fx:id="lblSpecifique1Nom" text="" GridPane.rowIndex="6" />
                                <Label fx:id="lblSpecifique1Valeur" text="" GridPane.columnIndex="1" GridPane.rowIndex="6" />
                                <Label fx:id="lblSpecifique2Nom" text="" GridPane.rowIndex="7" />
                                <Label fx:id="lblSpecifique2Valeur" text="" GridPane.columnIndex="1" GridPane.rowIndex="7" />
                            </children>
                        </GridPane>
                        <Separator />
                        <Label styleClass="detail-subtitle" text="Synopsis :" />
                        <TextArea fx:id="txtDescriptionDetail" editable="false" focusTraversable="false" prefRowCount="5" wrapText="true" VBox.vgrow="ALWAYS" />
                        <Button fx:id="btnAjouterWatchlist" maxWidth="Infinity" onAction="#toggleWatchlistMedia" text="Ajouter à la Watchlist" />
                    </children>
                </VBox>
            </items>
        </SplitPane>
    </center>
</BorderPane>